# PostgreSQL connection string (local default for `brew services start postgresql@17`)
DATABASE_URL=postgres://USER@localhost:5432/creatorai

# Optional: password for the seeded demo@creatorai.dev owner (random + printed if unset)
SEED_DEMO_PASSWORD=

# Public base URL used in emailed links (required in production outside Vercel; Vercel's production URL is used otherwise)
APP_URL=
# Optional: send email via Resend (https://resend.com). Without these, dev prints emails to the server console.
RESEND_API_KEY=
EMAIL_FROM=
